---
import Button from "@/components/Button.astro";
import { type Picture, mediaSize } from "@/utils/content.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Photos to show. Each one's alt text doubles as its caption. */
  photos: Picture[];
}

const { render = true, photos } = Astro.props;
---

{
  render && photos.length > 0 && (
    <div class="dest-gallery_wrap">
      <ul class="dest-gallery_list" tabindex="0" aria-label="Photos">
        {photos.map((photo, index) => (
          <li class="dest-gallery_slide">
            {/* The caption below says what the photo shows, so the image doesn't repeat it. */}
            <img
              src={photo.src}
              alt=""
              loading={index === 0 ? "eager" : "lazy"}
              decoding="async"
              {...mediaSize(photo.src)}
            />
            {photo.alt && <span class="dest-gallery_caption">{photo.alt}</span>}
          </li>
        ))}
      </ul>
      {photos.length > 1 && (
        <Fragment>
          <Button
            variant="arrow"
            direction="back"
            emphasis="secondary"
            class="dest-gallery_prev"
          />
          <Button
            variant="arrow"
            emphasis="secondary"
            class="dest-gallery_next"
          />
        </Fragment>
      )}
    </div>
  )
}

<script>
  for (const gallery of document.querySelectorAll<HTMLElement>(
    ".dest-gallery_wrap",
  )) {
    const list = gallery.querySelector<HTMLElement>(".dest-gallery_list");
    if (!list) continue;
    const move = (direction: number) => {
      const atEnd = list.scrollLeft + list.clientWidth >= list.scrollWidth - 4;
      const atStart = list.scrollLeft <= 4;
      // Going past either end wraps round to the other.
      if (direction > 0 && atEnd)
        list.scrollTo({ left: 0, behavior: "smooth" });
      else if (direction < 0 && atStart)
        list.scrollTo({ left: list.scrollWidth, behavior: "smooth" });
      else
        list.scrollBy({
          left: direction * list.clientWidth,
          behavior: "smooth",
        });
    };
    gallery
      .querySelector(".dest-gallery_prev")
      ?.addEventListener("click", () => move(-1));
    gallery
      .querySelector(".dest-gallery_next")
      ?.addEventListener("click", () => move(1));
  }
</script>

<style is:global>
  @layer components {
    .dest-gallery_wrap {
      position: relative;
      width: 100%;
      overflow: clip;
      border-radius: var(--radius-main);
    }

    .dest-gallery_list {
      display: flex;
      aspect-ratio: 4 / 5;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .dest-gallery_slide {
      position: relative;
      flex: none;
      width: 100%;
      scroll-snap-align: start;

      & img {
        width: 100%;
        height: 100%;
      }
    }

    .dest-gallery_caption {
      position: absolute;
      top: 0;
      right: 0;
      padding: 0.25em 1em;
      background-color: color-mix(in srgb, black 45%, transparent);
      border-radius: 0 0 0 var(--radius-main);
      color: var(--light-100);
      font-size: 0.75rem;
      font-style: italic;
    }

    .dest-gallery_prev,
    .dest-gallery_next {
      position: absolute;
      top: 50%;
      translate: 0 -50%;
    }

    .dest-gallery_prev {
      left: var(--space-1);
    }

    .dest-gallery_next {
      right: var(--space-1);
    }
  }
</style>
