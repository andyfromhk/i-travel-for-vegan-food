---
interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Reader quotes and who wrote them. Wrap a phrase in ** to make it bold. */
  reviews: { text: string; name?: string }[];
}

const { render = true, reviews } = Astro.props;
const escape = (value: string) =>
  value.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const html = (value: string) =>
  escape(value).replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");
---

{
  render && reviews.length > 0 && (
    <ul class="reviews_wrap">
      {reviews.map((review) => (
        <li class="reviews_item">
          <span class="reviews_stars" role="img" aria-label="5 out of 5 stars">
            ★★★★★
          </span>
          <q
            class="reviews_quote"
            set:html={html(review.text).replace(/^“|”$/g, "")}
          />
          {review.name && <p class="reviews_name">{review.name}</p>}
        </li>
      ))}
    </ul>
  )
}

<style is:global>
  @layer components {
    .reviews_wrap {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
      width: 100%;

      @media (width >= 48rem) {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    .reviews_item {
      display: flex;
      flex-direction: column;
      padding: var(--space-3);
      background-color: var(--yellow-100);
      border-radius: var(--radius-main);
    }

    .reviews_stars {
      color: #f5a623;
      font-size: 2rem;
      letter-spacing: 0.1em;
      /* A taller line adds empty space above the stars, which made the card look top-heavy. */
      line-height: 1;
    }

    .reviews_quote {
      font-size: 0.85rem;
      font-style: italic;
    }

    .reviews_name {
      margin-top: var(--space-2);
      font-size: 0.8rem;
      font-weight: var(--primary-medium);

      &::before {
        content: "— ";
      }
    }
  }
</style>
