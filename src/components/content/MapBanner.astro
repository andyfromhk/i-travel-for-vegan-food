---
import Icon from "@/components/media/Icon.astro";
import pin from "@/assets/icons/pin-outline.svg";
import { type Destination, mediaSize } from "@/utils/content.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The destination whose restaurant map is opened. */
  destination?: Destination;
  /** Banner size. `sidebar` is the small one beside a guide. */
  variant?: "banner" | "sidebar";
  /** Where the banner leads. Leave out on the destination page itself, where it opens the map. */
  href?: string;
}

const { render = true, destination, variant = "banner", href } = Astro.props;
const graphic = destination?.data.mapGraphic;
const Tag = href ? "a" : "button";
const attrs = href
  ? { href }
  : { type: "button" as const, "data-map-open": "" };
---

{
  render && destination && (
    <Tag
      class:list={["map-banner_wrap", variant !== "banner" && variant]}
      data-vt-destination={destination.id}
      {...attrs}
    >
      {graphic && (
        <img
          class="map-banner_image"
          src={graphic.src}
          alt=""
          loading="lazy"
          decoding="async"
          {...mediaSize(graphic.src)}
        />
      )}
      <span class="map-banner_label">
        <Icon src={pin} variant="small" />
        Open {destination.data.name} Restaurant Map
      </span>
    </Tag>
  )
}

<style is:global>
  @layer components {
    .map-banner_wrap {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: clamp(14rem, 30vw, 25rem);
      overflow: clip;
      background-color: var(--brand-100);
      cursor: pointer;

      &.sidebar {
        height: 11rem;
        border: var(--border-width) solid var(--brand-500);
        border-radius: 1.25rem;
      }

      @media (hover: hover) {
        &:hover .map-banner_image {
          filter: brightness(95%);
        }

        &:hover .map-banner_label {
          background-color: var(--brand-600);
        }
      }
    }

    .map-banner_image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      transition: filter var(--hover-duration) var(--hover-ease);
    }

    .map-banner_label {
      position: relative;
      display: flex;
      align-items: center;
      gap: 0.5em;
      padding: 0.4em 1.5em;
      background-color: var(--brand-500);
      border-radius: var(--radius-round);
      color: var(--brand-text);
      font-size: clamp(1rem, 2vw, 1.5rem);
      transition: background-color var(--hover-duration) var(--hover-ease);

      .sidebar > & {
        padding: 0.3em 1.25em;
        font-size: 0.875rem;
      }
    }
  }
</style>
