---
import Icon from "@/components/media/Icon.astro";
import Button from "@/components/Button.astro";
import chevron from "@/assets/icons/chevron.svg";
import closeIcon from "@/assets/icons/close.svg";
import pin from "@/assets/icons/pin-outline.svg";
import {
  type Destination,
  type Place,
  mediaSize,
  placeKind,
  placeUrl,
  priceRanges,
  taxonomies,
  vegTypes,
} from "@/utils/content.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The destination whose restaurants are mapped. */
  destination: Destination;
  /** Restaurants to list, already in "most popular" order. */
  places: Place[];
}

const { render = true, destination, places } = Astro.props;
const name = destination.data.name;

/* Only offer the filters this destination can use. */
const used = (key: "vegType" | "priceRange") =>
  new Set(places.map((p) => p.data[key]));
const vegOptions = taxonomies.vegTypes
  .filter((v) => used("vegType").has(v.slug))
  .reverse();
const priceOptions = taxonomies.priceRanges
  .filter((p) => used("priceRange").has(p.slug))
  .reverse();
const priceRank = (slug?: string) =>
  priceRanges.get(slug ?? "")?.symbols.length ?? "";
---

{
  /*
  The fullscreen restaurant map. Hidden until "Open … Restaurant Map" is pressed.
  The data-* attributes are how src/scripts/destination.js and src/scripts/place-filters.js find each part.
*/
}
{
  render && places.length > 0 && (
    <div class="dest-map_wrap" data-map-overlay data-place-filters hidden>
      <div class="dest-map_panel">
        <div class="dest-map_head">
          <p class="text-style-h4">Vegan-Friendly Restaurants in {name}</p>
          <div class="dest-map_tools">
            <button class="dest-map_tool" type="button" data-filter-open>
              Filters
            </button>
            <details class="dest-map_sort" data-sort-menu>
              <summary class="dest-map_tool">
                <span data-sort-label>Sort by</span>
                <Icon src={chevron} variant="small" />
              </summary>
              <div class="dest-map_sort_menu">
                <button
                  type="button"
                  data-sort-field="likes"
                  aria-current="true"
                >
                  Most Popular
                </button>
                <button type="button" data-vt-sort="distance">
                  Distance from Me
                </button>
                <button type="button" data-sort-field="created">
                  Recently Added
                </button>
                <button
                  type="button"
                  data-sort-field="name"
                  data-sort-dir="asc"
                >
                  Name: A to Z
                </button>
                <button
                  type="button"
                  data-sort-field="name"
                  data-sort-dir="desc"
                >
                  Name: Z to A
                </button>
                <button
                  type="button"
                  data-sort-field="price"
                  data-sort-dir="asc"
                >
                  Price: Low to High
                </button>
                <button
                  type="button"
                  data-sort-field="price"
                  data-sort-dir="desc"
                >
                  Price: High to Low
                </button>
              </div>
            </details>
            <span class="dest-map_tool" data-vt-saved-toggle>
              Saved
            </span>
          </div>
          <div class="dest-map_tags" data-filter-tags hidden />
          <p class="dest-map_count text-style-small">
            Showing <span data-filter-shown>{places.length}</span> of{" "}
            {places.length}
          </p>
        </div>

        <ul class="dest-map_list" data-map-list>
          {places.map((place) => {
            const { data } = place;
            const veg = vegTypes.get(data.vegType ?? "");
            const price = priceRanges.get(data.priceRange ?? "");
            return (
              <li
                class="dest-map_card"
                id={place.id}
                data-map-card
                data-name={data.name}
                data-search={[
                  data.name,
                  data.nameOriginal,
                  placeKind(place),
                  data.district,
                ]
                  .filter(Boolean)
                  .join(" ")
                  .toLowerCase()}
                data-veg={data.vegType}
                data-veg-name={veg?.name}
                data-price={data.priceRange}
                data-price-symbols={price?.symbols}
                data-price-rank={priceRank(data.priceRange)}
                data-likes={data.likes ?? 0}
                data-created={data.created?.toISOString()}
                data-lat={data.location?.lat}
                data-lng={data.location?.lng}
                data-chain={data.chain ? "" : undefined}
                data-maps={data.mapsUrl}
                data-address={data.address}
                data-locator={data.storeLocator}
              >
                <div class="dest-map_card_image" data-map-card-image>
                  {data.image && (
                    <img
                      src={data.image.src}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      {...mediaSize(data.image.src)}
                    />
                  )}
                </div>
                <div class="dest-map_card_content">
                  <div class="dest-map_card_meta" data-map-card-meta>
                    {veg && (
                      <span
                        class="dest-map_card_veg"
                        style={`color: ${veg.colour}`}
                      >
                        {veg.name}
                      </span>
                    )}
                    {price && (
                      <span class="dest-map_card_price">{price.symbols}</span>
                    )}
                  </div>
                  <a
                    class="dest-map_card_name text-style-h5"
                    href={placeUrl(place)}
                  >
                    {data.name}
                  </a>
                  <span class="dest-map_card_kind">{placeKind(place)}</span>
                  {data.summary && (
                    <p class="dest-map_card_text">{data.summary}</p>
                  )}
                </div>
                {data.chain ? (
                  <span class="dest-map_card_chain">Multiple locations</span>
                ) : (
                  data.location && (
                    <button
                      class="dest-map_card_locate"
                      type="button"
                      data-map-locate
                      aria-label={`Show ${data.name} on the map`}
                    >
                      <Icon src={pin} variant="small" />
                    </button>
                  )
                )}
              </li>
            );
          })}
        </ul>
        <p class="dest-map_empty" data-filter-empty hidden>
          No results found :( Try clearing the filters to show more results.
        </p>
      </div>

      <div class="dest-map_canvas" id="map-wrapper" />

      <button
        class="dest-map_close"
        type="button"
        data-map-close
        aria-label="Close the map"
      >
        <Icon src={closeIcon} variant="small" />
      </button>

      <dialog class="dest-map_filters" data-filter-panel aria-label="Filters">
        <div class="dest-map_filters_inner">
          <div class="dest-map_filters_head">
            <p class="text-style-h4">Filters</p>
            <button
              class="dest-map_filters_clear"
              type="button"
              data-filter-clear
            >
              Clear all
            </button>
          </div>
          <label class="dest-map_filters_group">
            <span class="dest-map_filters_title">Search</span>
            <input
              class="dest-map_filters_search"
              type="search"
              placeholder="Search restaurants…"
              data-filter-search
            />
          </label>
          <fieldset class="dest-map_filters_group">
            <legend class="dest-map_filters_title">Veg Type</legend>
            {vegOptions.map((option) => (
              <label class="dest-map_filters_option">
                <input
                  type="checkbox"
                  name="veg"
                  value={option.slug}
                  data-label={option.name}
                />
                <span style={`color: ${option.colour}`}>{option.name}</span>
              </label>
            ))}
          </fieldset>
          <fieldset class="dest-map_filters_group">
            <legend class="dest-map_filters_title">Price Range</legend>
            {priceOptions.map((option) => (
              <label class="dest-map_filters_option">
                <input
                  type="checkbox"
                  name="price"
                  value={option.slug}
                  data-label={option.symbols}
                />
                <span>
                  {option.symbols} · {option.name}
                </span>
              </label>
            ))}
          </fieldset>
          <Button data-filter-close>Show results</Button>
        </div>
      </dialog>
    </div>
  )
}

<script>
  import "@/scripts/destination.js";
  import "@/scripts/place-filters.js";
</script>

<style is:global>
  @layer components {
    .dest-map_wrap {
      position: fixed;
      inset: 0;
      z-index: 200;
      display: grid;
      grid-template-rows: 45dvh minmax(0, 1fr);
      background-color: var(--background);

      &[hidden] {
        display: none;
      }

      @media (width >= 48rem) {
        grid-template-columns: minmax(22rem, 2fr) 3fr;
        grid-template-rows: minmax(0, 1fr);
      }
    }

    .dest-map_panel {
      display: flex;
      flex-direction: column;
      min-height: 0;
      order: 2;

      @media (width >= 48rem) {
        order: 0;
        border-right: var(--border-width) solid var(--brand-500);
      }
    }

    .dest-map_head {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      padding: var(--space-3);
      border-bottom: var(--border-width) solid var(--border);
    }

    .dest-map_tools {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-1);
    }

    .dest-map_tool {
      display: inline-flex;
      align-items: center;
      gap: 0.4em;
      padding: 0.35em 1em;
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-round);
      font-size: 0.8rem;
      font-weight: var(--primary-medium);
      cursor: pointer;
      list-style: none;
      transition: border-color var(--hover-duration) var(--hover-ease);

      &::-webkit-details-marker {
        display: none;
      }

      @media (hover: hover) {
        &:hover {
          border-color: var(--brand-500);
        }
      }
    }

    .dest-map_sort {
      position: relative;
    }

    .dest-map_sort_menu {
      position: absolute;
      top: calc(100% + 0.25rem);
      left: 0;
      z-index: 5;
      display: flex;
      flex-direction: column;
      min-width: 12rem;
      padding: var(--space-1);
      background-color: var(--background);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-main);
      box-shadow: 0 0.5rem 1.5rem
        color-mix(in srgb, var(--text) 12%, transparent);

      & button {
        padding: 0.45em 0.8em;
        border-radius: var(--radius-small);
        font-size: 0.8rem;

        &[aria-current="true"] {
          color: var(--brand-500);
          font-weight: var(--primary-medium);
        }

        @media (hover: hover) {
          &:hover {
            background-color: var(--brand-100);
          }
        }
      }
    }

    .dest-map_tags {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-1);

      &[hidden] {
        display: none;
      }
    }

    .dest-map_tag {
      padding: 0.2em 0.9em;
      background-color: var(--brand-100);
      border-radius: var(--radius-round);
      font-size: 0.75rem;
    }

    .dest-map_count {
      color: var(--dark-500);
    }

    .dest-map_list {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      min-height: 0;
      padding: var(--space-3);
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    .dest-map_card {
      position: relative;
      display: grid;
      grid-template-columns: 6.5rem minmax(0, 1fr) auto;
      align-items: start;
      gap: var(--space-2);
      flex: none;
      padding: var(--space-1);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-main);
      transition: border-color var(--hover-duration) var(--hover-ease);

      &[hidden] {
        display: none;
      }
    }

    .dest-map_card_image {
      position: relative;
      aspect-ratio: 1;
      overflow: clip;
      background-color: var(--background-skeleton);
      border-radius: var(--radius-small);

      & img {
        width: 100%;
        height: 100%;
      }
    }

    .dest-map_card_content {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      min-width: 0;
      padding-block: 0.2rem;
    }

    .dest-map_card_meta {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0 var(--space-2);
      font-size: 0.65rem;
    }

    .dest-map_card_veg {
      font-style: italic;
      font-weight: var(--primary-bold);
      letter-spacing: 0.1ch;
      text-transform: uppercase;
    }

    .dest-map_card_price,
    .dest-map_card_kind {
      color: var(--dark-500);
    }

    .dest-map_card_name {
      text-box: none;

      @media (hover: hover) {
        &:hover {
          text-decoration: underline;
        }
      }
    }

    .dest-map_card_kind {
      font-size: 0.7rem;
    }

    .dest-map_card_text {
      font-size: 0.75rem;
      line-height: var(--line-height-large);
      text-box: none;
    }

    .dest-map_card_locate {
      display: grid;
      place-items: center;
      width: 2rem;
      height: 2rem;
      border: var(--border-width) solid var(--border);
      border-radius: 50%;
      color: var(--brand-500);
      transition: border-color var(--hover-duration) var(--hover-ease);

      @media (hover: hover) {
        &:hover {
          border-color: var(--brand-500);
        }
      }
    }

    .dest-map_card_chain {
      max-width: 5rem;
      color: var(--dark-500);
      font-size: 0.65rem;
      font-style: italic;
      text-align: right;
    }

    .dest-map_empty {
      padding: var(--space-4);
      text-align: center;

      &[hidden] {
        display: none;
      }
    }

    .dest-map_canvas {
      min-height: 0;
      background-color: var(--background-2);
    }

    .dest-map_close {
      position: absolute;
      top: var(--space-2);
      right: var(--space-2);
      z-index: 6;
      display: grid;
      place-items: center;
      width: 2.5rem;
      height: 2.5rem;
      background-color: var(--background);
      border: var(--border-width) solid var(--brand-500);
      border-radius: 50%;
      color: var(--brand-500);
    }

    /* Filter panel */
    .dest-map_filters {
      width: min(26rem, calc(100vw - var(--space-4)));
      max-height: calc(100dvh - var(--space-6));
      margin: auto;
      padding: 0;
      overflow: auto;
      background-color: var(--background);
      border: var(--border-width) solid var(--brand-500);
      border-radius: var(--radius-main);
      color: var(--text);

      &::backdrop {
        background-color: color-mix(in srgb, black 40%, transparent);
      }
    }

    .dest-map_filters_inner {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      padding: var(--space-4);
    }

    .dest-map_filters_head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-3);
    }

    .dest-map_filters_clear {
      color: var(--dark-500);
      font-size: 0.8rem;
      font-style: italic;
      text-decoration: underline;
    }

    .dest-map_filters_group {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      min-width: 0;
      padding: 0;
      border: 0;
    }

    .dest-map_filters_title {
      margin-bottom: 0.2rem;
      padding: 0;
      font-size: 0.8rem;
      font-weight: var(--primary-bold);
    }

    .dest-map_filters_search {
      padding: 0.5em 1em;
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-round);
    }

    .dest-map_filters_option {
      display: flex;
      align-items: center;
      gap: 0.6em;
      font-size: 0.85rem;
      cursor: pointer;

      & input {
        width: 1.1em;
        height: 1.1em;
        accent-color: var(--brand-500);
      }
    }

    /* Markers and their tooltips (built by destination.js) */
    #map-wrapper .map-marker {
      width: 1.5rem;
      height: 1.5rem;
      border: 0.125rem solid var(--light-100);
      border-radius: 50%;
      box-shadow: 0 0.0625rem 0.1875rem
        color-mix(in srgb, black 30%, transparent);
      cursor: pointer;
      translate: 0 50%;
      transition:
        scale var(--hover-duration) var(--hover-ease),
        box-shadow var(--hover-duration) var(--hover-ease);

      &.active {
        scale: 1.25;
        box-shadow: 0 0.1875rem 0.375rem
          color-mix(in srgb, black 50%, transparent);
      }
    }

    #map-wrapper .marker-tooltip {
      position: absolute;
      bottom: calc(100% + 0.4rem);
      left: 50%;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.3rem;
      width: max-content;
      max-width: 14rem;
      padding: 0.5rem 0.9rem;
      translate: -50% 0;
      background-color: var(--light-100);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-main);
      color: var(--dark-900);
      font-family: var(--primary-family);
      text-align: center;

      & .horizontal-flex {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      & .veg-type-pill {
        padding: 0.15rem 0.4rem;
        border-radius: 0.25rem;
        color: var(--light-100);
        font-size: 0.6rem;
        font-style: italic;
        font-weight: var(--primary-medium);
        letter-spacing: 0.15ch;
        line-height: 1.2;
        text-transform: uppercase;
        white-space: nowrap;
      }

      & .listing-info {
        color: var(--dark-500);
        font-size: 0.8rem;
      }

      & .listing-title {
        font-size: 0.875rem;
        font-weight: var(--primary-medium);
      }
    }
  }
</style>
