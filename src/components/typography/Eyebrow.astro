---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** HTML element. */
  tag?: "span" | "p" | "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Eyebrow style. */
  variant?: "default" | "tag";
};

const {
  render = true,
  tag: Tag = "p",
  variant = "default",
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
---

{
  render && content && (
    <div
      class:list={["eyebrow_wrap", variant !== "default" && variant, className]}
      {...rest}
    >
      <Tag class="eyebrow_text text-style-small">
        <Fragment set:html={content} />
      </Tag>
    </div>
  )
}

<style is:global>
  @layer components {
    .eyebrow_wrap {
      display: inline-flex;
      align-items: center;
      justify-content: var(--_alignment, start);
      gap: var(--space-2);
      color: var(--brand-500);

      &.tag {
        background-color: var(--brand-500);
        color: var(--brand-text);
        padding: 0.15em 0.6em;
        border-radius: var(--radius-small);
      }

      .eyebrow_text {
        font-size: 0.8rem;
        font-style: italic;
        font-weight: var(--primary-bold);
        letter-spacing: 0.1ch;
        line-height: var(--line-height-large);
        text-transform: uppercase;
      }
    }
  }
</style>
