---
import { pagePath } from "@/utils/seo.ts";
import Icon from "@/components/media/Icon.astro";
import SignupForm from "@/components/content/SignupForm.astro";
import instagram from "@/assets/icons/instagram.svg";
import pinterest from "@/assets/icons/pinterest.svg";
import { SITE_NAME, SOCIAL, SHOP_URL } from "@/consts.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The country the page is about, for the sign-up's free cheat sheet (see SignupForm). */
  country?: string;
}

const { render = true, country } = Astro.props;

const path = pagePath(Astro.url.pathname);
const links = [
  { href: "/", label: "Home" },
  { href: "/destinations", label: "Destinations" },
  { href: SHOP_URL, label: "Shop Vegan Travel Books" },
  { href: "/articles", label: "Vegan Foodie Guides" },
  { href: "/about", label: "About" },
];
---

{
  render && (
    <footer class="footer_wrap">
      <div class="footer_inner">
        <SignupForm variant="footer" country={country} />

        <div class="footer_main">
          <nav aria-label="Footer">
            <ul class="footer_links">
              {links.map((link) => (
                <li>
                  <a
                    class="footer_link"
                    href={link.href}
                    aria-current={path === link.href ? "page" : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <ul class="footer_social">
            <li>
              <a
                class="footer_social_link"
                href={SOCIAL.instagram}
                target="_blank"
                rel="noopener"
                aria-label="Instagram"
              >
                <Icon src={instagram} variant="medium" />
              </a>
            </li>
            <li>
              <a
                class="footer_social_link"
                href={SOCIAL.pinterest}
                target="_blank"
                rel="noopener"
                aria-label="Pinterest"
              >
                <Icon src={pinterest} variant="medium" />
              </a>
            </li>
          </ul>
        </div>

        <div class="footer_bottom text-style-small">
          <p>
            &copy; <span id="year">{new Date().getFullYear()}</span> {SITE_NAME}
            . All rights reserved.
          </p>
          <p class="footer_credit">
            Website by{" "}
            <a
              href="https://www.veganbuzz.com.au/"
              target="_blank"
              rel="noopener"
            >
              VeganBuzz
            </a>
          </p>
        </div>
      </div>
    </footer>
  )
}

<script>
  const year = document.querySelector<HTMLSpanElement>("#year");
  if (year) year.textContent = new Date().getFullYear().toString();
</script>

<style is:global>
  @layer components {
    .footer_wrap {
      display: flex;
      justify-content: center;
      padding-block: var(--space-6);
      padding-inline: var(--site-margin);
      background-color: var(--background-3);
      color: var(--text);
      border-top: var(--border-width) solid var(--brand-500);
    }

    .footer_inner {
      width: 100%;
      max-width: var(--max-width-small);
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
    }

    .footer_main {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-3) var(--space-5);
      padding-top: var(--space-5);
      border-top: var(--border-width) solid var(--brand-500);
    }

    .footer_links {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-2) var(--space-5);
      font-size: 0.8rem;
      font-weight: var(--primary-medium);
    }

    .footer_link {
      transition: color var(--hover-duration) var(--hover-ease);

      /* The page you're on. The darker green keeps it readable on the grey footer. */
      &[aria-current="page"] {
        color: var(--brand-600);
        text-decoration: underline;
        text-decoration-thickness: var(--border-width);
        text-underline-offset: 0.1875rem;
      }

      @media (hover: hover) {
        &:hover {
          color: var(--brand-500);
        }
      }
    }

    .footer_social {
      display: flex;
      gap: var(--space-2);
    }

    .footer_social_link {
      display: flex;
      transition: color var(--hover-duration) var(--hover-ease);

      @media (hover: hover) {
        &:hover {
          color: var(--brand-500);
        }
      }
    }

    .footer_bottom {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: var(--space-1) var(--space-4);
      color: var(--dark-700);
    }

    .footer_credit {
      font-style: italic;
    }
  }
</style>
