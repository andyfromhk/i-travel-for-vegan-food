---
import { pagePath } from "@/utils/seo.ts";
import Icon from "@/components/media/Icon.astro";
import NavLink from "@/components/global/NavLink.astro";
import Button from "@/components/Button.astro";
import chevron from "@/assets/icons/chevron.svg";
import MapIcon from "@/assets/icons/map.svg";
import { SITE_NAME, SHOP_URL } from "@/consts.ts";
import { destinationCounts, destinationGroups } from "@/utils/content.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Fix the nav over the page. */
  overlap?: boolean;
}

const { render = true, overlap = false } = Astro.props;
const path = pagePath(Astro.url.pathname);

/* The menu's groups, each destination marked when it has a restaurant map. Groups with many
   destinations (Japan) list them in two columns, as the old menu did. */
const groups = await Promise.all(
  (await destinationGroups()).map(async (group) => ({
    title: group.slug === "more" ? "Other Destinations" : group.title,
    wide: group.destinations.length > 6,
    destinations: await Promise.all(
      group.destinations.map(async (destination) => ({
        name: destination.data.name,
        href: `/destinations/${destination.id}`,
        hasMap: (await destinationCounts(destination)).hasMap,
      })),
    ),
  })),
);
const onDestinations = path === "/destinations";
---

{
  render && (
    <header class:list={["nav_wrap", overlap && "overlap"]}>
      <div class="nav_inner">
        <a class="nav_logo" href="/" aria-label={SITE_NAME}>
          <img src="/site/brand/logo.webp" alt="" width="40" height="40" />
        </a>
        <nav class="nav_menu" id="nav-menu" aria-label="Main">
          <div class="nav_menu_inner">
            <ul class="nav_links">
              <li>
                <details class="nav_dropdown">
                  <summary
                    class="nav_link nav_dropdown_toggle"
                    aria-current={onDestinations ? "page" : undefined}
                  >
                    <span>Destinations</span>
                    <Icon
                      class="nav_dropdown_icon"
                      src={chevron}
                      variant="small"
                    />
                  </summary>
                  <div class="nav_dropdown_panel">
                    <div class="nav_dropdown_inner">
                      <div class="nav_dropdown_groups">
                        {groups.map((group) => (
                          <div
                            class:list={[
                              "nav_dropdown_group",
                              group.wide && "wide",
                            ]}
                          >
                            <p class="nav_dropdown_title text-style-h4">
                              {group.title}
                            </p>
                            <ul class="nav_dropdown_list">
                              {group.destinations.map((destination) => (
                                <li>
                                  <a
                                    class="nav_dropdown_link"
                                    href={destination.href}
                                    aria-current={
                                      path === destination.href
                                        ? "page"
                                        : undefined
                                    }
                                  >
                                    {destination.name}
                                    {destination.hasMap && (
                                      <MapIcon
                                        class="nav_dropdown_map"
                                        role="img"
                                        aria-label="(has a restaurant map)"
                                      />
                                    )}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </div>
                        ))}
                      </div>
                      <a
                        class="nav_dropdown_all"
                        href="/destinations"
                        aria-current={onDestinations ? "page" : undefined}
                      >
                        All destinations →
                      </a>
                    </div>
                  </div>
                </details>
              </li>
              <NavLink href="/articles">Vegan Foodie Guides</NavLink>
              <NavLink href="/about">About</NavLink>
            </ul>
          </div>
        </nav>
        <div class="nav_actions">
          <Button
            element="link"
            href={SHOP_URL}
            aria-label="Shop Vegan Travel Books"
          >
            <span class="nav_shop_short">Shop Books</span>
            <span class="nav_shop_full">Shop Vegan Travel Books</span>
          </Button>
          <button
            class="nav_toggle"
            type="button"
            aria-label="Menu"
            aria-expanded="false"
            aria-controls="nav-menu"
          >
            <span class="nav_toggle_icon" />
          </button>
        </div>
      </div>
    </header>
  )
}

{/* No-JS fallback */}
<noscript>
  <style>
    .nav_toggle {
      display: none;
    }
    .nav_menu {
      grid-template-rows: 1fr;
      visibility: visible;
    }
    .nav_menu_inner {
      opacity: 1;
    }
  </style>
</noscript>

<script>
  const nav = document.querySelector<HTMLElement>(".nav_wrap");
  const toggle = nav?.querySelector<HTMLButtonElement>(".nav_toggle");
  const dropdown = nav?.querySelector<HTMLDetailsElement>(".nav_dropdown");
  const wide = window.matchMedia("(width >= 48rem)");

  if (nav && toggle) {
    const setOpen = (open: boolean) => {
      nav.classList.toggle("open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        setOpen(false);
        if (dropdown) dropdown.open = false;
      });
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      if (dropdown?.open) {
        dropdown.open = false;
        dropdown.querySelector<HTMLElement>("summary")?.focus();
      } else if (nav.classList.contains("open")) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Node)) return;
      if (dropdown?.open && wide.matches && !dropdown.contains(target))
        dropdown.open = false;
      if (nav.classList.contains("open") && !nav.contains(target))
        setOpen(false);
    });

    wide.addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
      if (dropdown) dropdown.open = false;
    });
  }
</script>

<style is:global>
  @layer components {
    .nav_wrap {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      justify-content: center;
      padding-inline: var(--site-margin);
      background-color: var(--background);
      color: var(--text);
      border-bottom: var(--border-width) solid var(--brand-500);

      &.overlap {
        position: fixed;
        inset-inline: 0;
      }
    }

    .nav_inner {
      width: 100%;
      max-width: var(--max-width-main);
      min-height: var(--nav-height);
      display: flex;
      align-items: center;
      gap: 0 var(--space-6);
    }

    .nav_logo {
      flex: none;
      display: flex;
      align-items: center;
      width: 2.5rem;
    }

    .nav_actions {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      margin-left: auto;
    }

    /* The shop button uses a shorter label where the bar is narrow. */
    .nav_shop_full {
      display: none;
    }

    @media (width >= 30rem) {
      .nav_shop_short {
        display: none;
      }

      .nav_shop_full {
        display: inline;
      }
    }

    .nav_toggle {
      --_icon-width: 1.5rem;
      --_bar-gap: 0.5rem;

      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 2.75rem;
      min-height: 2.75rem;
      margin-right: calc((2.75rem - var(--_icon-width)) / -2);
      color: inherit;
      border-radius: var(--radius-small);
    }

    .nav_toggle_icon {
      position: relative;
      display: block;
      width: var(--_icon-width);
      height: calc(var(--_bar-gap) + var(--border-width));

      &::before,
      &::after {
        content: "";
        position: absolute;
        inset-inline: 0;
        height: var(--border-width);
        background-color: currentcolor;
        transition: transform var(--open-duration) var(--open-ease);
      }

      &::before {
        top: 0;
      }

      &::after {
        top: var(--_bar-gap);
      }
    }

    .nav_wrap.open .nav_toggle_icon {
      &::before {
        transform: translateY(calc(var(--_bar-gap) / 2)) rotate(45deg);
      }

      &::after {
        transform: translateY(calc(var(--_bar-gap) / -2)) rotate(-45deg);
      }
    }

    .nav_menu {
      position: absolute;
      top: 100%;
      inset-inline: 0;
      display: grid;
      grid-template-rows: 0fr;
      visibility: hidden;
      max-height: calc(100svh - var(--nav-height));
      overflow-x: clip;
      overflow-y: auto;
      overscroll-behavior: contain;
      background-color: var(--background);
      border-bottom: var(--border-width) solid var(--brand-500);
      transition:
        grid-template-rows var(--open-duration) var(--open-ease),
        visibility var(--open-duration) var(--open-ease);
    }

    .nav_menu_inner {
      overflow: hidden;
      opacity: 0;
      transition: opacity var(--open-duration) var(--open-ease);
    }

    .nav_wrap.open .nav_menu {
      grid-template-rows: 1fr;
      visibility: visible;
    }

    .nav_wrap.open .nav_menu_inner {
      opacity: 1;
      overflow-y: auto;
    }

    .nav_links {
      display: flex;
      flex-direction: column;
      padding: var(--space-2) var(--site-margin) var(--space-4);
      font-size: 0.875rem;
      font-weight: var(--primary-bold);

      & > li + li {
        border-top: var(--border-width) solid var(--border);
      }
    }

    .nav_link {
      display: block;
      padding-block: var(--space-3);
      color: var(--text);
      text-decoration: none;
      transition: color var(--hover-duration) var(--hover-ease);

      @media (hover: hover) {
        &:hover {
          color: var(--brand-500);
        }
      }
    }

    /* The page you're on: green and underlined, in the menu and the footer alike */
    :is(.nav_link, .nav_dropdown_link, .nav_dropdown_all)[aria-current="page"] {
      color: var(--brand-500);
      text-decoration: underline;
      text-decoration-thickness: var(--border-width);
      text-underline-offset: 0.1875rem;
    }

    /* Destinations mega menu */
    .nav_dropdown_toggle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5em;
      cursor: pointer;
      list-style: none;

      &::-webkit-details-marker {
        display: none;
      }
    }

    .nav_dropdown_icon {
      transition: rotate var(--open-duration) var(--open-ease);
    }

    .nav_dropdown[open] .nav_dropdown_icon {
      rotate: 180deg;
    }

    .nav_dropdown_inner {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      padding-bottom: var(--space-4);
    }

    .nav_dropdown_groups {
      display: grid;
      gap: var(--space-4);
    }

    .nav_dropdown_title {
      margin-bottom: var(--space-1);
      color: var(--brand-500);
    }

    .nav_dropdown_list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 var(--space-4);
    }

    .nav_dropdown_link {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      /* Every row is as tall as one with a map icon, so the columns line up. */
      min-height: calc(1.5em + 0.8rem);
      padding-block: 0.4rem;
      font-weight: var(--primary-medium);
      transition: color var(--hover-duration) var(--hover-ease);

      @media (hover: hover) {
        &:hover {
          color: var(--brand-500);
        }
      }
    }

    .nav_dropdown_map {
      flex: none;
      width: 1.5em;
      height: 1.5em;
    }

    .nav_dropdown_all {
      align-self: flex-start;
      color: var(--brand-500);
      font-style: italic;
      text-decoration: underline;
    }

    @media (width >= 48rem) {
      .nav_toggle {
        display: none;
      }

      .nav_menu {
        position: static;
        display: block;
        visibility: visible;
        overflow: visible;
        background-color: transparent;
        border-bottom: 0;
      }

      .nav_menu_inner {
        overflow: visible;
        opacity: 1;
      }

      .nav_links {
        flex-direction: row;
        align-items: center;
        padding: 0;
        gap: var(--space-5);

        & > li + li {
          border-top: 0;
        }
      }

      .nav_link {
        padding-block: var(--space-3);
      }

      /* The panel spans the whole width of the page, under the bar. */
      .nav_dropdown_panel {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        display: flex;
        justify-content: center;
        padding-inline: var(--site-margin);
        background-color: var(--background);
        border-bottom: var(--border-width) solid var(--brand-500);
      }

      .nav_dropdown_inner {
        width: 100%;
        max-width: var(--max-width-main);
        padding: var(--space-4) 8% var(--space-6);
      }

      .nav_dropdown_groups {
        display: flex;
        gap: var(--space-5);
      }

      /* A group listed in two columns (Japan) gets half as much room again. */
      .nav_dropdown_group {
        flex: 1 1 0;
        min-width: 0;

        &.wide {
          flex-grow: 1.5;
        }
      }

      .nav_dropdown_list {
        grid-template-columns: minmax(0, 1fr);

        .wide > & {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }
    }
  }
</style>
