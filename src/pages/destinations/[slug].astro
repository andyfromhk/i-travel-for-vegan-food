---
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Grid from "@/components/wrapper/Grid.astro";
import Heading from "@/components/typography/Heading.astro";
import RichText from "@/components/typography/RichText.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import DestinationMap from "@/components/section/DestinationMap.astro";
import DestinationGallery from "@/components/content/DestinationGallery.astro";
import HeroDestination from "@/components/content/HeroDestination.astro";
import BookPromo from "@/components/content/BookPromo.astro";
import MapBanner from "@/components/content/MapBanner.astro";
import TravelBox from "@/components/content/TravelBox.astro";
import PlaceCard from "@/components/item/PlaceCard.astro";
import GuideCard from "@/components/item/GuideCard.astro";
import {
  getSite,
  guidesFor,
  placesIn,
  type Destination,
} from "@/utils/content.ts";
import { breadcrumbs } from "@/utils/schema.ts";

export async function getStaticPaths() {
  const { destinations } = await getSite();
  return destinations.map((destination) => ({
    params: { slug: destination.id },
    props: { destination },
  }));
}

interface Props {
  destination: Destination;
}

const { destination } = Astro.props;
const { data } = destination;
const name = data.name;
const { Content } = await render(destination);
const places = await placesIn(destination.id);
const guides = await guidesFor(destination.id);
const hasMap = places.some((place) => place.data.location);
const hasDescription = !!destination.body?.trim();

const schema = breadcrumbs([
  { name: "Home", path: "/" },
  { name: "Destinations", path: "/destinations" },
  { name, path: `/destinations/${destination.id}` },
]);
---

<BaseLayout
  title={`Vegan ${name} Restaurants and Food Guides`}
  description={`Find the best vegan food in ${name} with foodie guides, restaurant reviews and travel tips.`}
  image={data.image?.src}
  schema={schema}
  destinations={[destination.id]}
>
  {/* Title */}
  <Section paddingTop="pagetop" paddingBottom="none" gap="3" align="center">
    <HeroDestination name={name} />
  </Section>

  {/* About the city */}
  <Section
    render={hasDescription || data.gallery.length > 0}
    paddingTop="small"
    paddingBottom="small"
    containerClass="max-width-small"
  >
    <ContentWrapper variant="columns" column1Class="align-self-start">
      <div class="flex-vertical-nowrap gap-5">
        <RichText data-vt-richtext>
          <Content />
        </RichText>
        <BookPromo destination={destination} />
      </div>
      <DestinationGallery slot="column2" photos={data.gallery} />
    </ContentWrapper>
  </Section>

  {/* Restaurant map and the most popular places */}
  <Section
    render={places.length > 0}
    paddingTop="none"
    paddingBottom="small"
    gap="3"
    id="restaurants"
  >
    <h2 class="sr-only">Vegan-friendly restaurants in {name}</h2>
    <MapBanner render={hasMap} destination={destination} />
    <Grid xsmall={2} medium={4} class="gap-3">
      {
        places
          .slice(0, 8)
          .map((place) => <PlaceCard place={place} data-vt-heart />)
      }
    </Grid>
    <ButtonWrapper
      render={hasMap && places.length > 8}
      marginTop="0"
      class="align-self-end"
    >
      <Button variant="link" data-map-open
        >See all {places.length} places on the map →</Button
      >
    </ButtonWrapper>
  </Section>

  {/* Travel recommendations */}
  <Section
    paddingTop="small"
    paddingBottom={guides.length > 0 ? "none" : "medium"}
    containerClass="max-width-small"
  >
    <TravelBox destination={destination} />
  </Section>

  {/* Guides */}
  <Section
    render={guides.length > 0}
    paddingTop="small"
    paddingBottom="small"
    gap="4"
    containerClass="max-width-small"
    id="guides"
  >
    <Heading tag="h2" variant="h3">Vegan Foodie Guides for {name}</Heading>
    <Grid xsmall={2} class="gap-4">
      {guides.map((guide) => <GuideCard guide={guide} />)}
    </Grid>
    <ButtonWrapper marginTop="0" class="align-self-end">
      <Button element="link" variant="link" href="/articles"
        >See all vegan foodie guides →</Button
      >
    </ButtonWrapper>
  </Section>

  <DestinationMap destination={destination} places={places} />
</BaseLayout>
