---
import { getEntry, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import RichText from "@/components/typography/RichText.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import Form from "@/components/form/Form.astro";
import Input from "@/components/form/Input.astro";
import Select from "@/components/form/Select.astro";
import Textarea from "@/components/form/Textarea.astro";
import { GUEST_POST_GUIDELINES, SOCIAL, WEB3FORMS_KEY } from "@/consts.ts";
import { breadcrumbs } from "@/utils/schema.ts";

const page = (await getEntry("pages", "about"))!;
const { Content } = await render(page);

const reasons = [
  { value: "General Enquiry", label: "General Enquiry" },
  { value: "Suggest a New Vegan Place", label: "Suggest a New Vegan Place" },
  { value: "Report Outdated/Incorrect Info", label: "Report Outdated/Incorrect Info" },
  { value: "Advertising Opportunities", label: "Advertising Opportunities" },
  { value: "Invite & Collaboration", label: "Invite & Collaboration" },
  { value: "Guest Post Enquiry", label: "Guest Post Enquiry" },
];
const schema = breadcrumbs([
  { name: "Home", path: "/" },
  { name: "About", path: "/about" },
]);
---

<BaseLayout title={page.data.title} description={page.data.description} schema={schema}>
  {/* About Andy */}
  <Section paddingTop="small" paddingBottom="small" gap="5" containerClass="max-width-small">
    <Heading tag="h1" class="heading-accent">A Bit About <strong>I Travel For Vegan Food</strong></Heading>
    <ContentWrapper variant="columns">
      <img src="/site/brand/andy.webp" alt="Andy, the writer behind I Travel For Vegan Food" width="1000" height="1250" style="border-radius: var(--radius-main)" />
      <RichText slot="column2">
        <Content />
      </RichText>
    </ContentWrapper>
  </Section>

  {/* Social profiles */}
  <Section paddingTop="small" paddingBottom="small" gap="3" containerClass="max-width-small" align="center">
    <Heading tag="h2" variant="h3">Follow the Vegan Foodie Journey</Heading>
    <ButtonWrapper marginTop="0">
      <Button element="link" href={SOCIAL.instagram} target="_blank" rel="noopener">Follow @itravelforveganfood on Instagram</Button>
      <Button element="link" emphasis="secondary" href={SOCIAL.pinterest} target="_blank" rel="noopener">Follow @itravelforveganfood on Pinterest</Button>
    </ButtonWrapper>
  </Section>

  {/* Contact form: sent through Web3Forms to Andy's inbox */}
  <Section paddingTop="small" gap="4" containerClass="max-width-small" id="contact">
    <Heading tag="h2" variant="h3">Contact I Travel For Vegan Food</Heading>
    <Paragraph>
      I Travel For Vegan Food is all about building a helpful community for vegans! Whether you've found a new gem,
      want to correct some info, have an idea to work together, or want to share your guide through a guest post, I'd
      love to hear from you.
    </Paragraph>
    <Paragraph>
      Simply use the contact form below. Don't forget to select the nature of your inquiry in the dropdown menu so I
      can best assist you.
    </Paragraph>
    <Paragraph>
      p.s. If you're interested in writing for us, please take a moment to review the
      <a href={GUEST_POST_GUIDELINES} target="_blank" rel="noopener">guest post guidelines</a> before submitting your idea!
    </Paragraph>
    <Form
      name="contact"
      action="https://api.web3forms.com/submit"
      successMessage="Thank you! Your submission has been received!"
      errorMessage="Oops! Something went wrong while submitting the form."
    >
      <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
      <input type="hidden" name="subject" value="New message from itravelforveganfood.com" />
      <input type="hidden" name="from_name" value="I Travel For Vegan Food website" />
      {/* Web3Forms' own bot trap: real visitors never tick this hidden box. */}
      <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" style="display: none" />
      <Input label="Name" name="name" placeholder="" autocomplete="name" />
      <Input label="Email Address" variant="email" name="email" placeholder="" required />
      <Select label="Reason for Contacting" name="reason" placeholder="Select one..." options={reasons} required />
      <Textarea label="Your Message" name="message" placeholder="" maxlength={5000} required />
      <Button type="submit">Submit</Button>
    </Form>
  </Section>
</BaseLayout>
