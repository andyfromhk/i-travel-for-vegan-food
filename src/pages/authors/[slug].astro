---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import Grid from "@/components/wrapper/Grid.astro";
import Heading from "@/components/typography/Heading.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import GuideCard from "@/components/item/GuideCard.astro";
import AuthorIntro from "@/components/content/AuthorIntro.astro";
import { getSite, type Author } from "@/utils/content.ts";

export async function getStaticPaths() {
  const { authors } = await getSite();
  return authors.map((author) => ({
    params: { slug: author.id },
    props: { author },
  }));
}

interface Props {
  author: Author;
}

const { author } = Astro.props;
const { data } = author;
const site = await getSite();
// Guides without a named guest author are written by the site itself.
const guides = site.guides.filter(
  (guide) => (guide.data.author ?? "i-travel-for-vegan-food") === author.id,
);
---

<BaseLayout
  title="I Travel For Vegan Food"
  description={`Guides written by ${data.name} on I Travel For Vegan Food.`}
  image={data.image?.src}
>
  {/* About the author */}
  <Section
    paddingTop="pagetop"
    paddingBottom="small"
    containerClass="max-width-small"
  >
    <AuthorIntro author={author} />
  </Section>

  {/* Their guides */}
  <Section render={guides.length > 0} paddingTop="small" gap="4">
    <Heading tag="h2" variant="h3" class="align-self-center"
      >Latest Guides by {data.name}</Heading
    >
    <Grid xsmall={2} medium={4} class="gap-3">
      {guides.map((guide) => <GuideCard guide={guide} />)}
    </Grid>
    <ButtonWrapper marginTop="0" class="align-self-end">
      <Button element="link" variant="link" href="/articles"
        >See all vegan foodie guides →</Button
      >
    </ButtonWrapper>
  </Section>
</BaseLayout>
