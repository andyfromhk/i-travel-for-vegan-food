---
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import Grid from "@/components/wrapper/Grid.astro";
import Heading from "@/components/typography/Heading.astro";
import RichText from "@/components/typography/RichText.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import PlaceHero from "@/components/content/PlaceHero.astro";
import PlaceInfo from "@/components/content/PlaceInfo.astro";
import BookPromo from "@/components/content/BookPromo.astro";
import TravelBox from "@/components/content/TravelBox.astro";
import PhotoGrid from "@/components/content/PhotoGrid.astro";
import PlaceReview from "@/components/section/PlaceReview.astro";
import PlaceCard from "@/components/item/PlaceCard.astro";
import GuideCard from "@/components/item/GuideCard.astro";
import {
  getSite,
  guidesFor,
  hasPage,
  placesIn,
  priceRanges,
  venueTypes,
  cuisines,
  vegTypes,
  type Place,
} from "@/utils/content.ts";
import {
  absolute,
  author,
  breadcrumbs,
  imageObject,
  publisher,
  tidy,
} from "@/utils/schema.ts";

export async function getStaticPaths() {
  const { places } = await getSite();
  return places
    .filter(hasPage)
    .map((place) => ({ params: { slug: place.id }, props: { place } }));
}

interface Props {
  place: Place;
}

const { place } = Astro.props;
const { data } = place;
const site = await getSite();
const destination = site.destinationBySlug.get(data.destination ?? "");
const city = destination?.data.name ?? "";
const { Content } = await render(place);

const veg = vegTypes.get(data.vegType ?? "");
const venue = venueTypes.get(data.venueType ?? "");
const cuisine = cuisines.get(data.cuisine ?? "");
const price = priceRanges.get(data.priceRange ?? "");

const guides = destination ? (await guidesFor(destination.id)).slice(0, 6) : [];
const popular = destination
  ? (await placesIn(destination.id))
      .filter((p) => p.id !== place.id)
      .slice(0, 4)
  : [];

const title = `${data.name} - Photos, Menu, Review - Vegan food in ${city}`;
const description = `${data.summary ?? ""} - Review for ${data.name} - ${veg?.name ?? ""} ${venue?.name ?? ""} in ${city}`;

const schema = [
  tidy({
    "@context": "https://schema.org",
    "@type": "Review",
    itemReviewed: {
      "@type": venue?.schemaType ?? "Restaurant",
      name: data.name,
      description: data.summary,
      address: {
        "@type": "PostalAddress",
        streetAddress: data.address,
        addressLocality: city,
      },
      url: data.website,
      sameAs: [data.instagram, data.facebook],
      telephone: data.phone,
      priceRange: price?.symbols,
      servesCuisine: [cuisine?.name, veg?.name],
      geo: data.location && {
        "@type": "GeoCoordinates",
        latitude: data.location.lat,
        longitude: data.location.lng,
      },
      image: [imageObject(data.image)],
    },
    author,
    publisher,
    datePublished: data.created?.toISOString(),
    dateModified: data.updated?.toISOString(),
    reviewBody: data.summary,
    mainEntityOfPage: absolute(`/restaurants/${place.id}`),
  }),
  breadcrumbs([
    { name: "Home", path: "/" },
    { name: "Destinations", path: "/destinations" },
    ...(destination
      ? [{ name: city, path: `/destinations/${destination.id}` }]
      : []),
    { name: data.name, path: `/restaurants/${place.id}` },
  ]),
];
---

<BaseLayout
  title={title}
  description={description}
  image={data.image?.src}
  schema={schema}
  destinations={destination ? [destination.id] : []}
>
  {/* Name, details and photos */}
  <Section
    paddingTop="pagetop"
    paddingBottom="none"
    containerClass="max-width-medium"
  >
    <PlaceHero place={place} />
  </Section>

  {/* Review and location */}
  <PlaceReview paddingTop="small" paddingBottom="small">
    <RichText data-vt-richtext>
      <Content />
    </RichText>
    <PlaceInfo slot="info" place={place} />
    <ButtonWrapper slot="footer" marginTop="0" class="justify-content-end">
      <Button element="link" variant="link" href="/about#contact"
        >Suggest a place or correct outdated information →</Button
      >
    </ButtonWrapper>
    <BookPromo slot="promo" destination={destination} />
  </PlaceReview>

  {/* Travel recommendations */}
  <Section
    render={!!destination}
    paddingTop="none"
    paddingBottom="small"
    containerClass="max-width-small"
  >
    <TravelBox destination={destination} />
  </Section>

  {/* Photos */}
  <Section
    render={data.gallery.length > 0}
    id="food-and-drink"
    paddingTop="small"
    paddingBottom="small"
    gap="4"
  >
    <Heading tag="h2" variant="h3" class="align-self-center"
      >Food &amp; Drink Photos</Heading
    >
    <PhotoGrid photos={data.gallery} label="Food & Drink Photos" />
  </Section>
  <Section
    render={data.menu.length > 0}
    id="menu-and-vibe"
    paddingTop="small"
    paddingBottom="small"
    gap="4"
  >
    <Heading tag="h2" variant="h3" class="align-self-center"
      >Menu &amp; Vibe</Heading
    >
    <PhotoGrid photos={data.menu} label="Menu & Vibe" />
  </Section>

  {/* More places nearby */}
  <Section
    render={popular.length > 0}
    paddingTop="small"
    paddingBottom="small"
    gap="4"
  >
    <Heading tag="h2" variant="h3" class="align-self-center"
      >Popular Vegan-Friendly Restaurants in {city}</Heading
    >
    <Grid xsmall={2} medium={4} class="gap-3">
      {popular.map((item) => <PlaceCard place={item} />)}
    </Grid>
  </Section>

  {/* Guides */}
  <Section
    render={guides.length > 0}
    paddingTop="small"
    gap="4"
    containerClass="max-width-small"
  >
    <Heading tag="h2" variant="h3">More Vegan Foodie Guides for {city}</Heading>
    <Grid xsmall={2} class="gap-4">
      {guides.map((guide) => <GuideCard guide={guide} />)}
    </Grid>
    <ButtonWrapper marginTop="0" class="align-self-end">
      <Button
        element="link"
        variant="link"
        href={`/articles?destination=${destination?.id}`}
        >See all vegan foodie guides →</Button
      >
    </ButtonWrapper>
  </Section>
</BaseLayout>
